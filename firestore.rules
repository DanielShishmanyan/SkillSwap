rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function freshSession(verifiedAt) {
      return verifiedAt is int
        && verifiedAt * 1000 <= request.time.toMillis()
        && request.time.toMillis() < (verifiedAt + 43200) * 1000;
    }
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'custom'
        && 'email_otp' in request.auth.token
        && request.auth.token.email_otp == true
        && freshSession(request.auth.token.otp_verified_at);
    }
    function isSelf(id) { return signedIn() && request.auth.uid == id; }
    match /sessionBookings/{sessionId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow write: if false;
    }
    match /calendarConnections/{id} { allow read, write: if false; }
    match /calendarOAuthStates/{id} { allow read, write: if false; }
    match /sessionJobs/{id} { allow read, write: if false; }
    match /sessionEmails/{id} { allow read, write: if false; }
    match /sessionLimits/{id} { allow read, write: if false; }
    function participant(data) { return signedIn() && request.auth.uid in data.participantIds; }
    function protectedStatsUnchanged() {
      return request.resource.data.ratingAverage == resource.data.ratingAverage
        && request.resource.data.ratingCount == resource.data.ratingCount
        && request.resource.data.completedSwaps == resource.data.completedSwaps
        && request.resource.data.completedLessons == resource.data.completedLessons
        && request.resource.data.xp == resource.data.xp
        && request.resource.data.level == resource.data.level;
    }
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isSelf(userId) && request.resource.data.id == userId && request.resource.data.ratingAverage == 0 && request.resource.data.xp == 0;
      allow update: if isSelf(userId) && protectedStatsUnchanged() && request.resource.data.id == resource.data.id && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }
    match /skills/{skillId} { allow read: if signedIn(); allow write: if false; }
    match /swaps/{swapId} {
      allow read: if signedIn() && request.auth.uid in [resource.data.requesterId, resource.data.receiverId];
      allow create: if signedIn() && request.resource.data.requesterId == request.auth.uid && request.resource.data.receiverId != request.auth.uid && request.resource.data.status == 'pending';
      allow update: if signedIn() && request.auth.uid in [resource.data.requesterId, resource.data.receiverId]
        && request.resource.data.requesterId == resource.data.requesterId
        && request.resource.data.receiverId == resource.data.receiverId
        && request.resource.data.id == resource.data.id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requesterOffer','receiverOffer','deliveryMode','preferredStartDate','preferredEndDate','requesterMessage','status','lastProposedBy','proposalVersion','acceptedAt','completedAt','updatedAt']);
      match /sessions/{sessionId} {
        function parentSwap() { return get(/databases/$(database)/documents/swaps/$(swapId)).data; }
        allow read: if signedIn() && request.auth.uid in [parentSwap().requesterId, parentSwap().receiverId];
        allow create: if signedIn() && request.auth.uid in [parentSwap().requesterId, parentSwap().receiverId]
          && request.resource.data.swapId == swapId
          && request.resource.data.status == 'unscheduled'
          && request.resource.data.teacherId in [parentSwap().requesterId, parentSwap().receiverId]
          && request.resource.data.learnerId in [parentSwap().requesterId, parentSwap().receiverId]
          && request.resource.data.teacherId != request.resource.data.learnerId;
        allow update: if signedIn() && request.auth.uid in [parentSwap().requesterId, parentSwap().receiverId]
          && request.resource.data.teacherId == resource.data.teacherId
          && request.resource.data.learnerId == resource.data.learnerId
          && request.resource.data.skillId == resource.data.skillId
          && request.resource.data.sessionNumber == resource.data.sessionNumber
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scheduledAt','deliveryMode','meetingLink','location','status','completedAt','updatedAt']);
      }
    }
    match /lessons/{lessonId} {
      allow read: if signedIn() && request.auth.uid in [resource.data.teacherId, resource.data.studentId];
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid && request.resource.data.paymentStatus in ['unpaid','pending'];
      allow update: if signedIn() && request.auth.uid in [resource.data.teacherId, resource.data.studentId] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lessonStatus','updatedAt']);
    }
    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update, delete: if false;
    }
    match /conversations/{conversationId} {
      allow read, update: if participant(resource.data);
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds && request.resource.data.participantIds.size() == 2;
      match /messages/{messageId} {
        allow read: if participant(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow create: if participant(get(/databases/$(database)/documents/conversations/$(conversationId)).data) && request.resource.data.senderId == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000;
      }
    }
  }
}
