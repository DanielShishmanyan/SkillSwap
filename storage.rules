rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function verifiedSession() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email_otp == true
        && request.auth.token.otp_verified_at is int
        && request.auth.token.otp_verified_at * 1000 <= request.time.toMillis()
        && request.time.toMillis() < (request.auth.token.otp_verified_at + 43200) * 1000;
    }
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if verifiedSession() && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
  }
}
